/*********************************************************************
*  SF-E76 (RISC-V behind CoreSight DAP) — 정식 연결 설정
*
*  SEGGER 공식 RISC-V-behind-DAP 절차를 따르며, **두 훅을 역할대로 나눠 쓴다.**
*
*    ConfigTargetSettings()  AP map / DMI 위치 선언 (DLL 전역 연결 설정)
*                            CPU 자동검출보다 앞서 호출된다
*    InitTarget()            디버그 도메인 전원 인가 (저수준 target 초기화)
*                            ★ 분리 실험 결과 이쪽이 진짜 병목이었다
*
*  목적: **cold session 의 첫 connect 를 성공시키는 것.**
*    지금은 첫 connect 가 "Error while halting CPU / Specific core setup failed"
*    로 실패하고 두 번째에야 붙는다. 그 우회(bounded retry)를 없애는 게 목표다.
*
*  실측으로 확정된 값:
*    cJTAG (TIF=7), 10MHz            1000kHz 로 낮추면 활성화 실패
*    DP reg0   = 0x6BA0009D
*    CTRL/STAT = 0xF0000000          디버그 전원 ACK
*    APB Index 0 (APBAP1 @0x10000) 로 두 DM 모두 접근
*      0x81480000  hcore/CMCore/Fcore0/QCore  (코어 귀속 미확정)
*      0x81481000  Ncore
*
*  사용법:
*    JLinkExe -if cJTAG -speed 10000 -device RISC-V \
*             -JLinkScriptFile SF_E76_config.JLinkScript
*
*    pylink 에서:
*      jl.exec_command('ScriptFile = /path/SF_E76_config.JLinkScript')
*      jl.connect('RISC-V')
*
*  CoreBase 를 바꾸려면 아래 _CORE_BASE 만 수정한다.
*********************************************************************/

// ── 여기만 바꾸면 된다 ───────────────────────────────────────────────
__constant U32 _CORE_BASE = 0x81480000;   // DMI 레지스터 위치
                                          //   0x81480000 = hcore/CMCore/Fcore0/QCore
                                          //   0x81481000 = Ncore
__constant U32 _APB_INDEX = 0;            // DMI 가 붙은 AP (AddAP 의 Index)


/*********************************************************************
*  ConfigTargetSettings
*
*  J-Link 이 CPU 를 검출하기 **전에** AP 지형과 DMI 위치를 알려준다.
*  SEGGER KB(J-Link RISC-V): "there is no ROM table scan available for
*  RISC-V", "cannot auto-detect the AP location or DMI register
*  positioning in hybrid designs" — 그래서 이 선언이 필수다.
*********************************************************************/
int ConfigTargetSettings(void) {

  // cJTAG 활성화 시퀀스. 0=LONG(기본) 1=SHORT 2=WILIOT
  //   실측상 0 에서 동작. T32 의 CJTAGFLAGS(NOKEEPER USEOAC)와 대응 가능성.
  JLINK_ExecCommand("SetcJTAGInitMode = 0");

  // ── AP map — T32 SYStem.CONFIG 의 DP:0xN0000 값이 그대로 Addr 이다 ──
  //   Index 는 J-Link 내부 AP 맵 번호이지 하드웨어 APSEL 이 아니다.
  JLINK_ExecCommand("CORESIGHT_AddAP = Index=0 Type=APB-AP Addr=0x10000");  // APBAP1
  JLINK_ExecCommand("CORESIGHT_AddAP = Index=1 Type=APB-AP Addr=0x20000");  // APBAP2
  JLINK_ExecCommand("CORESIGHT_AddAP = Index=2 Type=AXI-AP Addr=0x30000");  // AXIAP1
  JLINK_ExecCommand("CORESIGHT_AddAP = Index=3 Type=AHB-AP Addr=0x40000");  // AHBAP1
  JLINK_ExecCommand("CORESIGHT_AddAP = Index=4 Type=APB-AP Addr=0x50000");  // APBAP3
  JLINK_ExecCommand("CORESIGHT_AddAP = Index=5 Type=APB-AP Addr=0x60000");  // APBAP4

  // ── RISC-V DMI 가 어느 AP 뒤에, 그 AP 안 어느 주소에 있는지 ──────────
  JLINK_ExecCommand("CORESIGHT_SetIndexAPBAPToUse = 0");
  JLINK_ExecCommand("CORESIGHT_SetCoreBaseAddr = 0x81480000");

  JLINK_SYS_Report("[SF-E76] ConfigTargetSettings: AP map + DMI base 선언 완료");
  JLINK_SYS_Report("[SF-E76]   APBAPToUse=0 (APBAP1 @0x10000)");
  JLINK_SYS_Report("[SF-E76]   CoreBaseAddr=0x81480000");
  return 0;
}


/*********************************************************************
*  InitTarget — 디버그 도메인 전원을 **미리** 올린다.
*
*  ★ 이 블록이 이 파일의 핵심이다.
*
*  분리 실험(isolate_warmup.py) 결과:
*      A  setup 1회 -> connect 2회       2회차 성공   ← 이것만 됨
*      B  setup 2회 -> connect 1회       실패
*      C  setup -> sleep -> connect      실패
*
*  설정을 두 번 넣어도, 기다려도 안 되고 **connect 시도 자체**가 있어야 한다.
*  즉 "레지스터를 써야 하는 일" 이 빠져 있다는 뜻이고, 그 후보가 ARM DAP 의
*  디버그 도메인 전원 인가다.
*
*  pylink 프로브에서 이미 실측으로 확인한 시퀀스:
*      CTRL/STAT <- 0x50000000   (CDBGPWRUPREQ | CSYSPWRUPREQ)
*      CTRL/STAT -> 0xF0000000   ACK 확인
*
*  J-Link 의 connect 도 결국 이걸 하지만, 같은 connect 안의 CPU setup 단계보다
*  **늦게** 하는 것으로 보인다. 그래서 1차는 실패하고 2차가 붙는다.
*  여기서 미리 올려두면 cold session 의 첫 connect 가 성공할 수 있다.
*
*  (기존 ARM 제품의 r8_pcsr_jtag.cfg 에서 손으로 넣던 `dpreg 4 0x50000000` 과
*   같은 동작이다.)
*
*  DP 레지스터 인덱스: 0=DPIDR/ABORT  1=CTRL/STAT  2=SELECT  3=RDBUFF
*********************************************************************/
int InitTarget(void) {
  U32 ctrl;
  int i;

  JLINK_SYS_Report("[SF-E76] InitTarget: 디버그 도메인 전원 인가 시작");

  // 단일 TAP, IRLen 4 (실측 TotalIRLen=4, IRPrint=0x01 = ARM DAP 서명)
  JLINK_CORESIGHT_Configure("IRPre=0;DRPre=0;IRPost=0;DRPost=0;IRLenDevice=4");

  // sticky error 클리어 후 전원 요청
  JLINK_CORESIGHT_WriteDP(0, 0x0000001E);   // ABORT
  JLINK_CORESIGHT_WriteDP(1, 0x50000000);   // CTRL/STAT: CSYSPWRUPREQ|CDBGPWRUPREQ

  // ACK 대기 — CSYSPWRUPACK(bit31) | CDBGPWRUPACK(bit29) = 0xA0000000
  i = 0;
  ctrl = 0;
  while (i < 20) {
    JLINK_SYS_Sleep(5);
    ctrl = JLINK_CORESIGHT_ReadDP(1);
    if ((ctrl & 0xA0000000) == 0xA0000000) {
      i = 20;
    }
    i = i + 1;
  }

  JLINK_SYS_Report1("[SF-E76] InitTarget: CTRL/STAT = ", ctrl);
  if ((ctrl & 0xA0000000) == 0xA0000000) {
    JLINK_SYS_Report("[SF-E76]   >> 전원 ACK 확인 — 첫 connect 가 성공해야 한다");
  } else {
    JLINK_SYS_Report("[SF-E76]   >> 전원 ACK 없음 — 이 경로로는 해결 안 됨");
    JLINK_SYS_Report("[SF-E76]      (그 경우 동일 handle bounded retry 로 우회)");
  }

  return 0;   // 0 = J-Link 통상 connect 절차를 계속 진행
}
