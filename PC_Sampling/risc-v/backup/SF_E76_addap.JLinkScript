/*********************************************************************
*  SF-E76 (RISC-V) — AP 명시 등록 + 코어 디버그 접근
*
*  v2. 1차 진단(pylink)에서 확정된 사실 위에 세운다:
*
*    ✅ cJTAG 활성화 성공 (TIF=7, 10MHz. 1000kHz 로 낮추면 실패)
*    ✅ DP 통신 성공        DPIDR    = 0x6BA0009D  (PARTNO 0xBA00 = ARM DAP)
*    ✅ 디버그 전원 인가    CTRL/STAT= 0xF0000000  (CSYSPWRUPACK|CDBGPWRUPACK)
*    ❌ AP 미발견           APSEL 0~255 / ADIv6 주소 모두 실패
*       그런데 **STICKY 0/256** — AP 가 없다는 하드웨어 응답이 아니라
*       **AP 트랜잭션이 발행조차 되지 않았다**는 뜻.
*
*  원인 가설: SEGGER DLL 은 AddAP 로 **등록된 AP 만** 접근을 허용한다.
*    pylink 는 AddAP 를 노출하지 않고, DLL 익스포트에도 없다
*    (JLinkScript 내장 함수라 스크립트 엔진에서만 호출 가능).
*    → 그래서 이 파일이 필요하다.
*
*  사용법:
*    JLinkExe -if cJTAG -speed 10000 -device <아무거나> \
*             -JLinkScriptFile SF_E76_addap.JLinkScript
*********************************************************************/

// T32 SYStem.CONFIG.COREDEBUG.Base (APB 공간)
__constant U32 _COREDEBUG_A = 0x81480000;   // hcore / CMCore / Fcore0 / QCore
__constant U32 _COREDEBUG_B = 0x81481000;   // Ncore

// MEM-AP CSW: 32bit + DbgSwEnable
__constant U32 _CSW = 0x80000002;


/*********************************************************************
*  _Sel — DP SELECT 로 APSEL + 뱅크 지정
*********************************************************************/
void _Sel(U32 ApSel, U32 Bank) {
  JLINK_CORESIGHT_WriteDP(2, (ApSel << 24) | ((Bank & 0xF) << 4));
}

/*********************************************************************
*  _ApIDR — 등록된 AP 의 IDR(오프셋 0xFC = 뱅크 0xF, 인덱스 3)
*********************************************************************/
U32 _ApIDR(U32 ApSel) {
  U32 v;
  _Sel(ApSel, 0xF);
  JLINK_CORESIGHT_ReadAP(3);        // AP 읽기는 파이프라인 → 첫 값 버림
  v = JLINK_CORESIGHT_ReadAP(3);
  return v;
}

/*********************************************************************
*  _Mem32 — MEM-AP 경유 32비트 읽기
*********************************************************************/
U32 _Mem32(U32 ApSel, U32 Addr) {
  U32 v;
  _Sel(ApSel, 0x0);                 // 뱅크 0 = CSW/TAR/DRW
  JLINK_CORESIGHT_WriteAP(0, _CSW); // CSW
  JLINK_CORESIGHT_WriteAP(1, Addr); // TAR
  JLINK_CORESIGHT_ReadAP(3);        // DRW — 첫 값 버림
  v = JLINK_CORESIGHT_ReadAP(3);
  return v;
}


int InitTarget(void) {
  U32 v;
  U32 ctrl;
  U32 ap;
  U32 i;

  JLINK_SYS_Report("");
  JLINK_SYS_Report("=================================================");
  JLINK_SYS_Report(" SF-E76  AddAP 경로  (JLinkScript v2)");
  JLINK_SYS_Report("=================================================");

  /*---- [1] DAP 설정 — 단일 TAP, IRLen 4 (실측) -------------------*/
  JLINK_CORESIGHT_Configure("IRPre=0;DRPre=0;IRPost=0;DRPost=0;IRLenDevice=4");
  JLINK_SYS_Report("[1] Configure: IRLenDevice=4");

  /*---- [2] DP 확인 -----------------------------------------------*/
  v = JLINK_CORESIGHT_ReadDP(0);
  JLINK_SYS_Report1("[2] DP reg0 = ", v);

  /*---- [3] 디버그 전원 (pylink 에서 동작 확인된 시퀀스) -----------*/
  JLINK_CORESIGHT_WriteDP(0, 0x0000001E);   // ABORT: sticky 클리어
  JLINK_CORESIGHT_WriteDP(1, 0x50000000);   // CTRL/STAT: 전원 요청
  JLINK_SYS_Sleep(20);
  ctrl = JLINK_CORESIGHT_ReadDP(1);
  JLINK_SYS_Report1("[3] CTRL/STAT = ", ctrl);
  if ((ctrl & 0xA0000000) == 0xA0000000) {
    JLINK_SYS_Report("    >> 전원 ACK 확인 (pylink 결과와 일치해야 정상)");
  } else {
    JLINK_SYS_Report("    >> 전원 ACK 없음 — pylink 와 다르다. 순서/타이밍 확인 필요");
  }

  /*---- [4] ★ AP 명시 등록 — 이게 이 파일의 존재 이유 -------------*
  *   T32 이름에서 타입 유추:
  *     APBAP1=AP1  APBAP2=AP2  AXIAP1=AP3  AHBAP1=AP4  APBAP3=AP5  APBAP4=AP6
  *   CORESIGHT_*_AP 은 JLinkScript 내장 상수.
  *   타입이 틀리면 등록은 되어도 IDR 이 안 읽힐 수 있다 → 그때 값 조정.
  *----------------------------------------------------------------*/
  JLINK_SYS_Report("[4] AP 등록 (AddAP)");
  JLINK_CORESIGHT_AddAP(1, CORESIGHT_APB_AP);   // APBAP1
  JLINK_CORESIGHT_AddAP(2, CORESIGHT_APB_AP);   // APBAP2
  JLINK_CORESIGHT_AddAP(3, CORESIGHT_AXI_AP);   // AXIAP1
  JLINK_CORESIGHT_AddAP(4, CORESIGHT_AHB_AP);   // AHBAP1
  JLINK_CORESIGHT_AddAP(5, CORESIGHT_APB_AP);   // APBAP3
  JLINK_CORESIGHT_AddAP(6, CORESIGHT_APB_AP);   // APBAP4
  JLINK_SYS_Report("    AP 1~6 등록 완료");

  /*---- [5] 등록 후 IDR 재읽기 ------------------------------------*
  *   IDR[3:0] TYPE : 1=AHB  2=APB  4=AXI
  *   pylink 에서는 여기가 전부 0 이었다. 값이 나오면 AddAP 가 원인이었던 것.
  *----------------------------------------------------------------*/
  JLINK_SYS_Report("[5] AP IDR 읽기");
  ap = 1;
  while (ap < 7) {
    v = _ApIDR(ap);
    JLINK_SYS_Report1("    APSEL ", ap);
    JLINK_SYS_Report1("      IDR = ", v);
    ap = ap + 1;
  }

  /*---- [6] 코어 디버그 블록 --------------------------------------*
  *   CoreSight 컴포넌트면 ID 레지스터로 자기 정체를 밝힌다.
  *     +0xFF0 CIDR0 : 하위 바이트 0x0D 면 CoreSight 확정
  *     +0xFCC DEVTYPE
  *----------------------------------------------------------------*/
  JLINK_SYS_Report("[6] 코어 디버그 블록 0x81480000 (APBAP 후보)");
  ap = 1;
  while (ap < 7) {
    v = _Mem32(ap, _COREDEBUG_A + 0xFF0);
    JLINK_SYS_Report1("    AP ", ap);
    JLINK_SYS_Report1("      CIDR0  = ", v);
    v = _Mem32(ap, _COREDEBUG_A + 0xFCC);
    JLINK_SYS_Report1("      DEVTYPE= ", v);
    ap = ap + 1;
  }

  JLINK_SYS_Report("-------------------------------------------------");
  JLINK_SYS_Report(" [5] IDR 이 0 아님       -> AddAP 가 원인이었다 (해결)");
  JLINK_SYS_Report(" [6] CIDR0 하위 = 0x0D   -> CoreSight 확정, 주소 정확");
  JLINK_SYS_Report(" [5] 여전히 0            -> AP 타입 상수 또는 APSEL 번호가 다름");
  JLINK_SYS_Report("=================================================");
  JLINK_SYS_Report("");

  return 0;   // J-Link 통상 절차 계속 (그 뒤 실패해도 위 진단은 남는다)
}
