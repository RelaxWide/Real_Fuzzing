--- a/drivers/nvme/host/core.c
+++ b/drivers/nvme/host/core.c
@@ -47,6 +47,12 @@
 	bool is_rotational;
 	bool no_vwc;
 };
+
+/* Opt-in policy for an owned PCIe firmware test device only. */
+static char *test_no_persistent_error_reset_bdf;
+module_param(test_no_persistent_error_reset_bdf, charp, 0400);
+MODULE_PARM_DESC(test_no_persistent_error_reset_bdf,
+	"FW test only: PCI BDF for logging persistent errors without an AER reset");
 
 unsigned int admin_timeout = 60;
 module_param(admin_timeout, uint, 0644);
@@ -4784,6 +4790,19 @@
 	return requeue;
 }
 
+static bool nvme_test_keep_running_on_persistent_error(struct nvme_ctrl *ctrl)
+{
+	if (!test_no_persistent_error_reset_bdf ||
+	    strcmp(ctrl->ops->name, "pcie") ||
+	    strcmp(dev_name(ctrl->dev), test_no_persistent_error_reset_bdf))
+		return false;
+
+	dev_warn_ratelimited(ctrl->device,
+		"FW TEST: persistent internal error on %s; skipping event-triggered reset, rearming AER\n",
+		dev_name(ctrl->dev));
+	return true;
+}
+
 static void nvme_handle_aer_persistent_error(struct nvme_ctrl *ctrl)
 {
 	dev_warn(ctrl->device,
@@ -4812,7 +4831,8 @@
 		 * For a persistent internal error, don't run async_event_work
 		 * to submit a new AER. The controller reset will do it.
 		 */
-		if (aer_subtype == NVME_AER_ERROR_PERSIST_INT_ERR) {
+		if (aer_subtype == NVME_AER_ERROR_PERSIST_INT_ERR &&
+		    !nvme_test_keep_running_on_persistent_error(ctrl)) {
 			nvme_handle_aer_persistent_error(ctrl);
 			return;
 		}
