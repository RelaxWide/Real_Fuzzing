{
  "schema_version": 1,
  "name": "v10.1 NVMe spec-derived command/response observation denominator",
  "specifications": {
    "base": "NVM Express Base Specification Revision 2.3 (2025-08-01)",
    "nvm_command_set": "NVM Express NVM Command Set Specification Revision 1.2 (2025-08-01)"
  },
  "semantics": {
    "claim": "A target pair is covered when the normalized SCT/SC pair is observed at least once under the canonical command/subcategory key.",
    "not_claimed": [
      "NVMe conformance",
      "correctness of the response for the generated input",
      "firmware code coverage",
      "exhaustiveness of vendor-specific responses"
    ],
    "coverage_key": [
      "queue",
      "opcode",
      "subcategory",
      "sct",
      "sc"
    ],
    "ignored_status_bits": [
      "DNR",
      "M",
      "CRD"
    ],
    "host_errno_timeout_and_unsubmitted_are_not_cqe_outcomes": true
  },
  "denominator_policy": {
    "fixed_for_campaign": true,
    "supported_command": "Use supported_outcomes. Resolve command support from mandatory requirements, Identify OACS/ONCS, and Commands Supported and Effects CSUPP when available.",
    "unsupported_command": "Use only SCT=0/SC=0x01 Invalid Command Opcode for that queue/opcode.",
    "supported_subcategory": "Use supported_outcomes inherited from its command plus extra_outcomes on the subcategory.",
    "unsupported_subcategory": "Use unsupported_outcomes on the command or subcategory.",
    "unknown_capability": "Do not guess. Mark unresolved and exclude from the numeric denominator until the product profile is frozen.",
    "default_exclusions": [
      "SCT=2 Media and Data Integrity outcomes requiring controlled media/data faults",
      "SCT=3 Path outcomes requiring ANA or multipath topology",
      "SCT=7 and SC=0xC0..0xFF vendor-specific outcomes without a product response specification",
      "abort, queue deletion, power-loss notification, and other externally induced completion outcomes",
      "status values disputed between tables in the cited revision"
    ]
  },
  "common_outcomes": {
    "unsupported_command": [
      {"sct": 0, "sc": 1, "name": "Invalid Command Opcode"}
    ],
    "selector_supported": [
      {"sct": 0, "sc": 0, "name": "Successful Completion"},
      {"sct": 0, "sc": 2, "name": "Invalid Field in Command"}
    ],
    "selector_unsupported_invalid_field": [
      {"sct": 0, "sc": 2, "name": "Invalid Field in Command"}
    ],
    "log_page_unsupported": [
      {"sct": 1, "sc": 9, "name": "Invalid Log Page"}
    ]
  },
